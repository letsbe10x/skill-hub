{
  "schema_version": 1,
  "name": "splunk",
  "version": "0.1.0",
  "description": "Splunk Enterprise — search via management REST API, ingest via HEC.",
  "vertical": "observability",
  "categories": ["logging", "monitoring"],
  "supported_ops": ["search", "ingest", "server-info"],
