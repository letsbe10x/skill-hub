    "optional": ["SPLUNK_HEC_URL", "SPLUNK_HEC_TOKEN", "SPLUNK_INDEX", "SPLUNK_INSECURE"]
  },
  "cli_command": "lets-splunk",
  "package": "lets-splunk",
  "shim_status": "follow-up"
}
